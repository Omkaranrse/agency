# ==============================================================================
# Agency Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as appropriate for your local setup.
# DO NOT commit real secrets, private keys, or tokens to source control.
# ==============================================================================

# Application Runtime & Security
AGENCY_ENVIRONMENT=development
AGENCY_API_KEY=
AGENCY_ALLOW_UNAUTHENTICATED=true
LOG_LEVEL=INFO
PORT=8000

# Persistence & Storage
AGENCY_CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
AGENCY_ARTIFACTS_DIR=./artifacts

# Dashboard Configuration
DASHBOARD_PORT=3000
DASHBOARD_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# AI Provider API Keys & Endpoints (Optional for fake/deterministic mode)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Sandbox Configuration
SANDBOX_TIMEOUT_SECONDS=300
MAX_AGENT_RETRIES=3

# External Deployment Adapters (Optional for local development & evaluations)
GITHUB_TOKEN=
GITHUB_OWNER=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Observability & Distributed Tracing (Self-hosted Langfuse)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PORT=3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
LANGFUSE_NEXTAUTH_SECRET=agency-dev-nextauth-secret-change-in-prod-min-32-chars
LANGFUSE_SALT=agency-dev-salt-change-in-prod-min-32-chars

# Evaluation Framework Budget Cap
MAX_EVAL_BUDGET_USD=5.00
