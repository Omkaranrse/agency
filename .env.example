# ==============================================================================
# Agency Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as appropriate for your local setup.
# DO NOT commit real secrets or credentials to source control.

# Application Runtime
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# AI Provider API Keys & Endpoints (Placeholders - populate in your private .env)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Sandbox Configuration (Placeholders for future phases)
SANDBOX_TIMEOUT_SECONDS=300
MAX_AGENT_RETRIES=3

# Observability Configuration (Placeholders for future phases)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agency
