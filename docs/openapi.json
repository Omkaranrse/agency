    "schemas": {
      "AgentRoleEnum": {
        "description": "Logical agent and operator roles represented in the virtual office.",
        "enum": [
          "manager",
          "pm",
          "designer",
          "builder",
          "qa",
          "reviewer",
          "devops"
        ],
        "title": "AgentRoleEnum",
        "type": "string"
      },
      "ApproveRunRequest": {
        "additionalProperties": false,
        "description": "Payload to authorize production build and deployment for the current preview.",
        "properties": {
          "approver": {
            "default": "client",
            "maxLength": 100,
            "minLength": 1,
            "title": "Approver",
            "type": "string"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "revision": {
            "description": "Preview revision being approved",
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "title": "ApproveRunRequest",
        "type": "object"
      },
      "ApproveRunResponse": {
        "additionalProperties": false,
        "description": "Result returned after approval is successfully accepted.",
        "properties": {
          "decision": {
            "default": "approved",
            "title": "Decision",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status",
          "revision"
        ],
        "title": "ApproveRunResponse",
        "type": "object"
      },
      "ArtifactMetadataDTO": {
        "additionalProperties": false,
