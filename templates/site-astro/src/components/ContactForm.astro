---
import type { ContactContent } from '../content/config';

interface Props {
  content: ContactContent;
}

const { content } = Astro.props;
const { form, mode, email, endpointUrl } = content;

const formAction = mode === 'endpoint' && endpointUrl
  ? endpointUrl
  : mode === 'mailto'
  ? `mailto:${email}`
  : undefined;

const formMethod = mode === 'endpoint' ? 'POST' : mode === 'mailto' ? 'POST' : undefined;
---

<div class="bg-bg-surface border border-border-subtle rounded-lg p-6 sm:p-8 md:p-10">
  {mode === 'static' && (
    <div
      class="mb-6 p-4 rounded-md bg-bg-elevated border-l-4 border-brand-primary text-xs sm:text-sm text-text-secondary"
      role="note"
    >
      <strong>Demo Mode:</strong> {form.staticModeNotice}
    </div>
  )}

  <form
    id="contact-form"
    action={formAction}
    method={formMethod}
    enctype={mode === 'mailto' ? 'text/plain' : undefined}
    class="space-y-6"
    novalidate={false}
  >
    <!-- Name Field -->
    <div>
      <label for="contact-name" class="block text-sm font-semibold text-text-primary mb-2">
        {form.nameLabel} <span class="text-brand-primary" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        aria-required="true"
        placeholder="Jane Doe"
        class="w-full px-4 py-2.5 rounded-md bg-bg-base border border-border-strong text-text-primary text-sm focus-visible:outline-2 focus-visible:outline-brand-primary transition-colors"
      />
    </div>

    <!-- Email Field -->
    <div>
      <label for="contact-email" class="block text-sm font-semibold text-text-primary mb-2">
        {form.emailLabel} <span class="text-brand-primary" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        aria-required="true"
        placeholder="jane@example.com"
        class="w-full px-4 py-2.5 rounded-md bg-bg-base border border-border-strong text-text-primary text-sm focus-visible:outline-2 focus-visible:outline-brand-primary transition-colors"
      />
    </div>

    <!-- Message Field -->
    <div>
      <label for="contact-message" class="block text-sm font-semibold text-text-primary mb-2">
        {form.messageLabel} <span class="text-brand-primary" aria-hidden="true">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        required
        aria-required="true"
        placeholder="Brief summary of your project or inquiry..."
        class="w-full px-4 py-2.5 rounded-md bg-bg-base border border-border-strong text-text-primary text-sm focus-visible:outline-2 focus-visible:outline-brand-primary transition-colors resize-y"
      ></textarea>
    </div>

    <!-- Privacy note -->
    <p class="text-xs text-text-muted leading-relaxed">
      {form.privacyNote}
    </p>

    <!-- Submission status announcement container -->
    <div
      id="form-status"
      class="hidden p-4 rounded-md text-sm font-medium"
      role="status"
      aria-live="polite"
    ></div>

    <!-- Submit Button -->
    <button
      type="submit"
      class="inline-flex items-center justify-center px-6 py-3 rounded-md font-semibold text-sm sm:text-base text-white bg-brand-primary hover:bg-brand-hover transition-colors duration-fast focus-visible:outline-2"
    >
      {form.submitLabel}
    </button>
  </form>
</div>

{mode === 'static' && (
  <script is:inline>
    const formEl = document.getElementById('contact-form');
    const statusEl = document.getElementById('form-status');

    if (formEl && statusEl) {
      formEl.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!formEl.checkValidity()) {
          formEl.reportValidity();
          return;
        }
        statusEl.className = 'p-4 rounded-md text-sm font-medium bg-bg-elevated text-text-primary border border-border-strong block';
        statusEl.textContent = 'Demonstration Mode: Form validated successfully. (In production, messages are routed to an email or endpoint service).';
      });
    }
  </script>
)}
