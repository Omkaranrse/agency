---
import type { ProjectItem } from '../content/config';

interface Props {
  projects: ProjectItem[];
  featuredOnly?: boolean;
}

const { projects, featuredOnly = false } = Astro.props;

const displayProjects = featuredOnly
  ? projects.filter((p) => p.featured)
  : projects;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
  {displayProjects.map((project) => (
    <article
      class="bg-bg-surface border border-border-subtle hover:border-border-strong rounded-lg overflow-hidden flex flex-col transition-all duration-fast"
      aria-labelledby={`project-title-${project.slug}`}
    >
      {project.image && (
        <div class="aspect-video w-full bg-bg-elevated overflow-hidden border-b border-border-subtle">
          <img
            src={project.image}
            alt={project.imageAlt}
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <div class="p-6 sm:p-8 flex-1 flex flex-col">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h3
            id={`project-title-${project.slug}`}
            class="text-xl sm:text-2xl font-bold text-text-primary"
          >
            {project.title}
          </h3>
          {project.featured && (
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-muted text-brand-primary">
              Featured
            </span>
          )}
        </div>

        <p class="text-text-secondary text-sm sm:text-base leading-relaxed mb-6 flex-1">
          {project.shortDescription}
        </p>

        <!-- Tech tags -->
        <div class="flex flex-wrap gap-2 mb-6" aria-label="Technologies used">
          {project.techTags.map((tag) => (
            <span class="text-xs font-medium px-2.5 py-1 rounded-sm bg-bg-elevated text-text-secondary border border-border-subtle">
              {tag}
            </span>
          ))}
        </div>

        <!-- Links -->
        <div class="flex items-center gap-4 pt-4 border-t border-border-subtle text-sm font-semibold">
          {project.liveDemoUrl && (
            <a
              href={project.liveDemoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-primary hover:text-brand-hover inline-flex items-center gap-1.5 focus-visible:outline-2"
              aria-label={`View live demo of ${project.title} (opens in new tab)`}
            >
              Live Demo
              <span aria-hidden="true">↗</span>
            </a>
          )}
          {project.sourceCodeUrl && (
            <a
              href={project.sourceCodeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-secondary hover:text-text-primary inline-flex items-center gap-1.5 focus-visible:outline-2"
              aria-label={`View source code for ${project.title} on GitHub (opens in new tab)`}
            >
              Source Code
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </article>
  ))}
</div>
